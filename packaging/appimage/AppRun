#!/bin/sh
set -eu
APPDIR="$(dirname "$(readlink -f "$0")")"
export PYTHONHOME="$APPDIR/usr"
export PYTHONPATH="$APPDIR/usr/lib/python3/dist-packages:$APPDIR/usr/share/time-sheet-linux"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GI_TYPELIB_PATH="$APPDIR/usr/lib/girepository-1.0"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
GDK_PIXBUF_MODULE_FILE="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/timesheet-pixbuf-XXXXXX")"
export GDK_PIXBUF_MODULE_FILE
"$APPDIR/usr/bin/gdk-pixbuf-query-loaders" "$APPDIR/usr/lib/gdk-pixbuf/libpixbufloader_svg.so" > "$GDK_PIXBUF_MODULE_FILE"
cd "$APPDIR/usr/share/time-sheet-linux"
exec "$APPDIR/usr/bin/python3" -m timesheet.app "$@"
